[
  {
    "test_name": "Valid Email and Password - Normal Case",
    "input": {
      "email": "john.doe@example.com",
      "password": "SecurePass123"
    },
    "expected": {
      "success": true,
      "message_contains": "successful"
    },
    "regression_check": false,
    "description": "Standard valid registration with proper email and password"
  },
  {
    "test_name": "Invalid Email - Double @ Symbol",
    "input": {
      "email": "user@@invalid.com",
      "password": "ValidPass123"
    },
    "expected": {
      "success": false,
      "message_contains": "invalid"
    },
    "regression_check": true,
    "description": "Email with double @ should be rejected but buggy version accepts it"
  },
  {
    "test_name": "Invalid Email - Missing Domain",
    "input": {
      "email": "test@.com",
      "password": "Password456"
    },
    "expected": {
      "success": false,
      "message_contains": "invalid"
    },
    "regression_check": true,
    "description": "Email missing domain name should fail validation"
  },
  {
    "test_name": "Invalid Email - No Domain Extension",
    "input": {
      "email": "user@domain",
      "password": "MyPass789"
    },
    "expected": {
      "success": false,
      "message_contains": "invalid"
    },
    "regression_check": true,
    "description": "Email without TLD should be rejected"
  },
  {
    "test_name": "Invalid Email - Missing Local Part",
    "input": {
      "email": "@example.com",
      "password": "StrongPass1"
    },
    "expected": {
      "success": false,
      "message_contains": "invalid"
    },
    "regression_check": true,
    "description": "Email starting with @ should fail"
  },
  {
    "test_name": "Weak Password - No Uppercase",
    "input": {
      "email": "valid@email.com",
      "password": "weakpass123"
    },
    "expected": {
      "success": false,
      "message_contains": "uppercase"
    },
    "regression_check": false,
    "description": "Password missing uppercase letter should be rejected"
  },
  {
    "test_name": "Weak Password - Too Short",
    "input": {
      "email": "another@valid.org",
      "password": "Short1"
    },
    "expected": {
      "success": false,
      "message_contains": "8 characters"
    },
    "regression_check": false,
    "description": "Password less than 8 characters should fail"
  },
  {
    "test_name": "Valid Complex Email",
    "input": {
      "email": "complex.name+tag@sub.domain.co.uk",
      "password": "ComplexP@ss1"
    },
    "expected": {
      "success": true,
      "message_contains": "successful"
    },
    "regression_check": false,
    "description": "Complex but valid email should be accepted"
  },
  {
    "test_name": "Boundary - Maximum Password Length",
    "input": {
      "email": "boundary@test.com",
      "password": "A1bcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ012"
    },
    "expected": {
      "success": true,
      "message_contains": "successful"
    },
    "regression_check": false,
    "description": "Password at 128 character limit should be accepted"
  },
  {
    "test_name": "Empty Email Field",
    "input": {
      "email": "",
      "password": "ValidPass123"
    },
    "expected": {
      "success": false,
      "message_contains": "empty"
    },
    "regression_check": false,
    "description": "Empty email should be rejected"
  }
]
