[
  {
    "id": "TC01",
    "description": "Nominal registration succeeds with strong password and unique identifiers.",
    "input": {
      "email": "alice@example.com",
      "password": "ValidPass!123",
      "username": "alice",
      "metadata": {"plan": "gold"}
    },
    "expected_output": {
      "status": "success",
      "message": "Registration successful"
    },
    "expected_status": "pass",
    "regression_indicator": false
  },
  {
    "id": "TC02",
    "description": "Borderline email with subdomain remains valid across implementations.",
    "input": {
      "email": "bob.senior@sub.example.co.uk",
      "password": "Comp!exPa55word",
      "username": "bobsenior"
    },
    "expected_output": {
      "status": "success",
      "message": "Registration successful"
    },
    "expected_status": "pass",
    "regression_indicator": false
  },
  {
    "id": "TC03",
    "description": "Password at maximum accepted length should still succeed.",
    "input": {
      "email": "charlie@example.com",
      "password": "A!aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa1Z",
      "username": "charlie"
    },
    "expected_output": {
      "status": "success",
      "message": "Registration successful"
    },
    "expected_status": "pass",
    "regression_indicator": false
  },
  {
    "id": "TC04",
    "description": "Malformed email missing domain should be rejected (regression-sensitive).",
    "input": {
      "email": "invalid@.com",
      "password": "StrongPass!123",
      "username": "invaliddomain"
    },
    "expected_output": {
      "status": "error",
      "message": "Invalid email format."
    },
    "expected_status": "fail",
    "regression_indicator": true
  },
  {
    "id": "TC05",
    "description": "Double at-sign should be rejected (regression-sensitive).",
    "input": {
      "email": "multi@@example.com",
      "password": "StrongPass!456",
      "username": "doubleat"
    },
    "expected_output": {
      "status": "error",
      "message": "Invalid email format."
    },
    "expected_status": "fail",
    "regression_indicator": true
  }
]
