[
  {
    "id": "case-001",
    "description": "Happy path registration of a brand-new user.",
    "input": {
      "email": "alice@example.com",
      "password": "Sup3rStr0ng!",
      "metadata": {"plan": "pro"}
    },
    "expected_output": {
      "status": "success",
      "message": "Registration successful"
    },
    "expected_status": "pass",
    "regression_indicator": false
  },
  {
    "id": "case-002",
    "description": "Reject malformed email missing @ symbol.",
    "input": {
      "email": "bob.example.com",
      "password": "ValidPassword1!"
    },
    "expected_output": {
      "error": "Invalid email format"
    },
    "expected_status": "fail",
    "regression_indicator": true
  },
  {
    "id": "case-003",
    "description": "Reject email with consecutive @ characters.",
    "input": {
      "email": "user@@mail",
      "password": "Password123!"
    },
    "expected_output": {
      "error": "Invalid email format"
    },
    "expected_status": "fail",
    "regression_indicator": true
  },
  {
    "id": "case-004",
    "description": "Reject email without domain label before dot.",
    "input": {
      "email": "test@.com",
      "password": "AnotherGood1!"
    },
    "expected_output": {
      "error": "Invalid email format"
    },
    "expected_status": "fail",
    "regression_indicator": true
  },
  {
    "id": "case-005",
    "description": "Boundary password length with valid email.",
    "input": {
      "email": "borderline@example.com",
      "password": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAaa1!"
    },
    "expected_output": {
      "status": "success",
      "message": "Registration successful"
    },
    "expected_status": "pass",
    "regression_indicator": false
  },
  {
    "id": "case-006",
    "description": "Duplicate registration attempt should be rejected.",
    "input": {
      "email": "dup@example.com",
      "password": "DupPassword1!"
    },
    "expected_output": {
      "error": "User with email 'dup@example.com' already exists"
    },
    "expected_status": "fail",
    "regression_indicator": false
  }
]
